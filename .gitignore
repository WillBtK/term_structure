# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Data caches and generated artifacts (per-country data/ and validation reports)
# Keep the directories tracked (.gitkeep) but ignore their contents.
us/data/*
germany/data/*
japan/data/*
uk/data/*
validation/reports/*
validation/data/*
!**/.gitkeep
*.pkl
*.parquet

# joblib / engine caches and logs
.cache/
*.log

# OS
.DS_Store

# Session scratch (not part of the repo)
scratchpad/
uk/data/*
switzerland/data/*
canada/data/*
viz/data_daily.parquet
viz/data.json
viz/global_factor_meta.json
viz/params/global_factor.json
scheduler/supabase_stage/

# Committed neutral-rate anchor INPUTS (survey / r* CSVs + README) — not caches;
# these must be versioned so the daily CI and a fresh clone reproduce the anchor.
!japan/data/anchors/
!japan/data/anchors/**
!germany/data/anchors/
!germany/data/anchors/**

# Committed Bund per-ISIN cross-section STORE — an accumulating archive, not a
# cache. The Bundesbank index exposes only the most recent ~5 monthly workbooks
# and does not retain matured securities, so history exists only if we keep it:
# every daily CI run unions the fresh months into this file and commits it.
!germany/data/bund_prices/
!germany/data/bund_prices/**

# Versioned DERIVED series (not caches): the US Treasury noise gauge. The raw price
# panel behind it stays a gitignored, rebuildable cache — but re-crawling a decade of
# FedInvest on every ephemeral CI run is not viable, so the daily series is committed
# and the job only appends new days.
!us/data_store/
!us/data_store/**
